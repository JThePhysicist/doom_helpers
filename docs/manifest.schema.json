{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "doomwad atlas manifest version 1",
  "type": "object",
  "required": [
    "version",
    "atlas_size",
    "padding",
    "palette",
    "pages",
    "sprites"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "atlas_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32767
    },
    "padding": {
      "type": "integer",
      "minimum": 0
    },
    "palette": {
      "type": "array",
      "minItems": 256,
      "maxItems": 256,
      "items": {
        "type": "array",
        "minItems": 3,
        "maxItems": 3,
        "items": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "pages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sprites": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "page",
          "x",
          "y",
          "width",
          "height",
          "left_offset",
          "top_offset"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "left_offset": {
            "type": "integer",
            "minimum": -32768,
            "maximum": 32767
          },
          "top_offset": {
            "type": "integer",
            "minimum": -32768,
            "maximum": 32767
          },
          "allocation": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "integer",
                "minimum": 1
              }
            ],
            "items": false,
            "minItems": 4
          }
        }
      }
    },
    "index_pages": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "patch_profile": {
      "enum": [
        "vanilla",
        "source-port"
      ]
    }
  }
}
